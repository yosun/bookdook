# Backend selection: 'ollama' (default), 'llamacpp', or 'dummy'
PLAIN_BACKEND=ollama

# Ollama settings
OLLAMA_MODEL=llama3
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# llama.cpp settings
LLAMACPP_MODEL_PATH=models/LLAMA3.1-8B-Instruct-Q4_K_M.gguf
LLAMACPP_CTX_SIZE=2048
LLAMACPP_N_THREADS=4

# General
PLAIN_MAX_TOKENS=512
